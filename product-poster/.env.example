# Khóa API của Claude (lấy tại https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Token Haravan (tạo app riêng trong Haravan, cấp quyền ghi sản phẩm)
HARAVAN_ACCESS_TOKEN=
# Tên miền trang quản trị, ví dụ: tencuahang.myharavan.com (để tạo link mở sản phẩm)
HARAVAN_SHOP_DOMAIN=
# Đặt thành false nếu Haravan báo lỗi ở trường tiêu đề/mô tả SEO
HARAVAN_SEND_SEO_FIELDS=true

# Thông tin cửa hàng, AI dùng trong đoạn cuối bài viết (không bắt buộc)
STORE_NAME=
STORE_HOTLINE=
STORE_INFO=

# Không bắt buộc
# CLAUDE_MODEL=claude-opus-5-5
# PORT=3000
